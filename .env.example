# このファイルを .env という名前でコピーして、使う LLM に合わせて書き換えてください。
# .env は .gitignore 済みです(API キーを公開しないため)。

# ---------------------------------------------------------------
# 使う LLM: anthropic(Claude) / openai(ChatGPT) / local(ローカル LLM)
# ---------------------------------------------------------------
LLM_PROVIDER=anthropic

# ライブ要約(数十秒ごとに呼ぶ)とレポート(発表ごとに 1 回)で別の LLM を使うこともできます
# 例: 要約はローカル LLM で無料に、レポートだけ Claude で丁寧に
# SUMMARY_PROVIDER=local
# REPORT_PROVIDER=anthropic
# 「AIに聞く」は省略時ライブ要約と同じ LLM。変えるときは ASK_PROVIDER / ASK_MODEL

# モデル名。anthropic は省略可(要約 claude-sonnet-5-5 / レポート claude-opus-5-5)
# openai と local では必須です
# SUMMARY_MODEL=
# REPORT_MODEL=

# ---------------------------------------------------------------
# anthropic(Claude)
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# openai(ChatGPT)。使えるモデル名は https://platform.openai.com/docs/models を参照
# ---------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # Azure OpenAI など別の接続先を使うときだけ

# ---------------------------------------------------------------
# local(OpenAI 互換 API を持つローカルサーバー)
#   Ollama:        http://localhost:11434/v1(既定)  モデル名の例: qwen2.5:14b
#   LM Studio:     http://localhost:1234/v1
#   llama.cpp:     http://localhost:8080/v1
# ---------------------------------------------------------------
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_API_KEY=     # キーが必要なサーバーだけ

# ---------------------------------------------------------------
# その他
# ---------------------------------------------------------------
# PORT=8765
